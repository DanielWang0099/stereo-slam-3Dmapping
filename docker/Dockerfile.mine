# -----------------------------------------------------------------------------
# Jetson Orin NX/Nano Deployment Dockerfile
# Using Ubuntu 22.04 with CUDA and installing Jetson/Isaac ROS manually
# -----------------------------------------------------------------------------

ARG BASE_IMAGE=nvidia/cuda:12.2.0-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# -------------------------
# Jetson-specific configuration
# -------------------------
ENV NVIDIA_VISIBLE_DEVICES all
ENV NVIDIA_DRIVER_CAPABILITIES compute,graphics,utility
ENV CUDA_FORCE_PTX_JIT=0

# -------------------------
# Install basic dependencies first
# -------------------------
RUN apt-get update && apt-get install -y \
    curl wget gnupg2 lsb-release build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# -------------------------
# Add ROS 2 repository and install ROS 2 Humble
# -------------------------
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        | tee /etc/apt/sources.list.d/ros2.list > /dev/null \
    && apt-get update && apt-get install -y \
        ros-humble-ros-base \
        python3-argcomplete \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# -------------------------
# Install common ROS2 packages and dependencies
# -------------------------
RUN apt-get update && apt-get install -y \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-camera-info-manager \
    ros-humble-image-geometry \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-rclcpp \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    ros-humble-geometry-msgs \
    ros-humble-nav-msgs \
    ros-humble-visualization-msgs \
    python3-pip \
    python3-numpy \
    libopencv-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# -------------------------
# Install additional build tools for Isaac ROS (to be built from source)
# -------------------------
RUN apt-get update && apt-get install -y \
    python3-vcstool \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# Note: Isaac ROS packages (ESS, Visual SLAM, Nvblox) must be built from source
# Clone them in /workspaces/isaac_ros-dev/src/ and build with colcon

# -------------------------
# GPU Memory Pool Configuration (Jetson optimization)
# -------------------------
RUN mkdir -p /etc/nvidia-container-runtime && \
    echo "disable-require: true" > /etc/nvidia-container-runtime/config.toml

ENV NITROS_BUFFER_SIZE=8388608
ENV JETSON_CLOCKS_ENABLED=0

# -------------------------
# Workspace
# -------------------------
WORKDIR /workspaces/isaac_ros-dev
