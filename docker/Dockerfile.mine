# Use the official NVIDIA JetPack base image for L4T R36.4.0 (compatible with R36.4.7)
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${BASE_IMAGE}

USER root
ENV DEBIAN_FRONTEND=noninteractive

# 1. Add NVIDIA Isaac ROS Repositories
RUN apt-get update && apt-get install -y curl gnupg2 lsb-release && \
    curl -s https://isaac.download.nvidia.com | apt-key add - && \
    echo "deb https://isaac.download.nvidia.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/isaac-ros.list

# 2. Install ROS 2 Humble and Isaac ROS packages
# Added ros-humble-desktop to include ROS core and essential tools
RUN apt-get update && apt-get install -y \
    ros-humble-desktop \
    ros-humble-isaac-ros-ess \
    ros-humble-isaac-ros-visual-slam \
    ros-humble-isaac-ros-nvblox \
    ros-humble-isaac-ros-image-proc \
    ros-humble-isaac-ros-stereo-image-proc \
    ros-humble-isaac-ros-nitros-bridge-ros2 \
    ros-humble-isaac-ros-pynitros \
    ros-humble-mavros \
    ros-humble-mavros-msgs \
    ros-humble-vision-msgs \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 3. Install Mavros GeographicLib datasets (Required for initialization)
RUN wget https://raw.githubusercontent.com && \
    bash ./install_geographiclib_datasets.sh && rm install_geographiclib_datasets.sh

# 4. Environment configuration for Orin Nano
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility
ENV NITROS_BUFFER_SIZE=8388608

WORKDIR /workspaces/isaac_ros-dev