# -----------------------------------------------------------------------------
# Jetson Orin - Build Isaac ROS from Source
# For when pre-built packages are not available
# BUILD THIS ON THE JETSON DEVICE
# -----------------------------------------------------------------------------

ARG BASE_IMAGE=dustynv/ros:humble-pytorch-l4t-r36.2.0
FROM ${BASE_IMAGE}

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-vcstool \
    python3-colcon-common-extensions \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create workspace
WORKDIR /workspaces/isaac_ros-dev

# Copy source repositories
COPY src/ ./src/

# Install ROS dependencies
RUN apt-get update && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -y && \
    rm -rf /var/lib/apt/lists/*

# Build the workspace
RUN . /opt/ros/humble/setup.sh && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

# Source the workspace in bashrc
RUN echo "source /workspaces/isaac_ros-dev/install/setup.bash" >> ~/.bashrc

CMD ["/bin/bash"]
